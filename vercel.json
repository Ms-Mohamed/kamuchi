{
  "version": 2,
  "builds": [
    {
      "src": "kamuchi-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "kamuchi-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/kamuchi-backend/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/kamuchi-backend/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
