{
  "version": 2,
  "builds": [
    {
      "src": "kamuchi-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "kamuchi-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/kamuchi-backend/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/kamuchi-backend/server.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/kamuchi-frontend/assets/$1"
    },
    {
      "source": "/logo.jpeg",
      "destination": "/kamuchi-frontend/logo.jpeg"
    },
    {
      "source": "/vite.svg",
      "destination": "/kamuchi-frontend/vite.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/kamuchi-frontend/index.html"
    }
  ]
}
